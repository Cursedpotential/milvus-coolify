# Milvus 3.0 + Attu / Coolify stack — copy to .env or set in the Coolify UI. Don't commit .env.
# Byline: Claude Code · Opus 4.8 · 2026-06-13

# Tailscale-direct phase (current): bind published ports to the host's TAILNET IP so
# Milvus/Attu are reachable over the tailnet but NOT on the public interface.
# ovh2-worker tailnet IP:
BIND_IP=100.91.190.107

# DOMAIN PHASE (set once DNS A-records exist + Traefik labels re-enabled in compose):
# MILVUS_DOMAIN=milvus.example.com   -> MILVUS_ADDRESS=https://<this>
# ATTU_DOMAIN=attu.example.com

# Host path for MAPPED (bind-mount) volume data — set to a stable, backed-up location
# so milvus (embedded etcd + local segments + woodpecker WAL) and attu data are easy
# to snapshot. (Owner preference: mapped volumes over named volumes.)
DOCKER_VOLUME_DIRECTORY=/data/milvus
